{
  "name": "cusa-identity",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w server",
    "test:browser": "npm run build && playwright test",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:bootstrap": "npm run db:bootstrap -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
