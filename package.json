{
  "name": "cusa-identity",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w server",
    "test:browser": "npm run build && playwright test",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:bootstrap": "npm run db:bootstrap -w server",
    "deploy:check": "node server/dist/scripts/deploymentCheck.js",
    "deploy:package": "node scripts/package-release.mjs",
    "ops:check": "npm run ops:check -w server",
    "evidence:purge": "npm run evidence:purge -w server",
    "db:cleanup": "node server/dist/scripts/cleanup.js",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "db:migrate:production": "node server/dist/migrate.js",
    "db:bootstrap:production": "node server/dist/bootstrap.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "gaxios@^6.0.0": {
      "uuid": "^11.1.1"
    }
  }
}
