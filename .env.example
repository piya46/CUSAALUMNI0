# Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# User-supplied MariaDB host. Use a least-privilege account; public endpoints require TLS in production.
DB_HOST=203.170.190.137
DB_PORT=3306
# Optional: absolute Unix socket path supplied by the host; host/port ignored, no TCP fallback.
DB_SOCKET_PATH=
DB_NAME=cusa_identity
DB_USER=
DB_PASSWORD=
DB_TLS=true
# On the deployment host only: DB_TLS=false supports localhost/loopback or a verified private IP.
# Example for a database on the same host: DB_HOST=127.0.0.1. See docs/PLESK.md.
# Optional: leave empty to use Node.js trusted CAs. Required only for a private/self-signed CA.
DB_CA_FILE=
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=100

# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_HOURS=8
OTP_MINUTES=5

# Google Web application OAuth client. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Personal @gmail.com: gmail_oauth. Workspace delegated mailbox: workspace_service_account.
MAIL_MODE=disabled
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Only Workspace service-account mode; do not put service account JSON in the frontend.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Empty uses durable MariaDB shared counters. Redis errors fail closed when configured.
# Upstash: Redis database > Connect > TCP. Copy rediss://default:PASSWORD@HOST:PORT.
# Use the TCP/TLS URL, not UPSTASH_REDIS_REST_URL (https://) or a REST token.
# Optional per-Service FIFO waiting rooms also require this Redis. Enable in Admin
# after migration 007; an enabled queue never falls back to memory/DB on failure.
REDIS_URL=
# Set 0 for immediate introspection revocation; 5 accepts up to 5 seconds of stale authorization.
INTROSPECTION_CACHE_SECONDS=5

# false for direct access; loopback or explicit IP/CIDR list ONLY after verifying proxy header sanitization.
# Legacy 1 trusts one hop: use only when all request paths have exactly one trusted proxy.
TRUST_PROXY=false
# Used by db:bootstrap or the opt-in web installer; never automatically on startup.
BOOTSTRAP_ADMIN_EMAIL=
# Enable only for first installation, then set false, clear token, and restart.
INSTALL_ENABLED=false
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INSTALL_TOKEN=

# Docker/Caddy deployment only (requires a domain pointing to your application host).
SSO_DOMAIN=sso.example.com

# MFA reset evidence: separate random 32-byte base64 key; directory outside Document Root.
# Do not rotate this key while evidence still exists; exclude evidence and its key files from backups.
MFA_EVIDENCE_KEY=
MFA_EVIDENCE_DIR=./var/mfa-evidence

# Run expiry/retention scans inside Node; work pauses while the process is stopped.
# Startup catch-up, then evidence 15m, operations 5m, expired credentials 60m.
BACKGROUND_JOBS_ENABLED=true

# Passkeys use APP_ORIGIN hostname as RP ID. Keep the production domain stable.
PASSKEY_ENABLED=true
# LINE Login and Messaging API channels MUST be under the same LINE Provider.
LINE_MFA_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Firebase Phone Auth. Public web config is intentionally exposed to the browser.
# Server service-account key stays private; use a dedicated Firebase project/account.
FIREBASE_PHONE_ENABLED=false
# Applies ONLY to accounts created after enabling; does not lock out existing users.
FIREBASE_PHONE_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional Prometheus: random 32-byte base64url bearer token, never a browser API key.
METRICS_TOKEN=
