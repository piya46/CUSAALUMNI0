# Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# User-supplied MariaDB host. Use a least-privilege account and verified TLS.
DB_HOST=203.170.190.137
DB_PORT=3306
DB_NAME=cusa_identity
DB_USER=
DB_PASSWORD=
DB_TLS=true
DB_CA_FILE=
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=100

# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_HOURS=8
OTP_MINUTES=5

# Google Web application OAuth client. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Personal @gmail.com: gmail_oauth. Workspace delegated mailbox: workspace_service_account.
MAIL_MODE=disabled
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Only Workspace service-account mode; do not put service account JSON in the frontend.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Empty uses durable MariaDB shared counters. Redis errors fail closed when configured.
REDIS_URL=
# Set 0 for immediate introspection revocation; 5 accepts up to 5 seconds of stale authorization.
INTROSPECTION_CACHE_SECONDS=5

# false for direct access. Use 1 ONLY behind exactly one trusted proxy with direct access blocked.
TRUST_PROXY=false
# Used only by explicit db:bootstrap command, never automatically on startup.
BOOTSTRAP_ADMIN_EMAIL=

# Docker/Caddy deployment only (requires a domain pointing to your application host).
SSO_DOMAIN=sso.example.com
