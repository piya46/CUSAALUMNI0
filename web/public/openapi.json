      "InactiveToken": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "active"
        ],
        "additionalProperties": false
      },
      "ExchangeRequest": {
        "type": "object",
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code"
            ]
          },
          "code": {
            "type": "string",
            "description": "Opaque credential: CSPRNG 32 bytes, base64url without padding",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "redirect_uri": {
            "type": "string",
            "description": "Callback เดียวกับ authorize",
            "minLength": 1,
            "maxLength": 2048
          },
          "code_verifier": {
            "type": "string",
            "description": "PKCE verifier เดิม ห้ามสร้างใหม่ที่ callback",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$"
          }
        },
        "required": [
          "grant_type",
          "code",
          "redirect_uri",
          "code_verifier"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Opaque credential: CSPRNG 32 bytes, base64url without padding",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "token_type": {
            "type": "string",
            "enum": [
