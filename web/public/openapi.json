          "email",
          "name",
          "given_name",
          "family_name",
          "department",
          "roles",
          "aud",
          "email_verified"
        ],
        "additionalProperties": false
      },
      "ActiveToken": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "description": "รหัสผู้ใช้ถาวร ใช้เป็น foreign key ของระบบปลายทาง",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "อีเมลที่ยืนยันแล้ว อาจเปลี่ยนได้ ไม่ใช่ primary user ID",
            "format": "email"
          },
          "name": {
            "type": "string",
            "description": "ชื่อแสดงผล"
          },
          "given_name": {
            "type": "string",
            "description": "ชื่อจริง อาจเป็นสตริงว่าง"
          },
          "family_name": {
            "type": "string",
            "description": "นามสกุล อาจเป็นสตริงว่าง"
          },
          "department": {
            "type": "string",
            "description": "หน่วยงานของผู้ใช้เฉพาะ Service นี้ อาจว่าง"
          },
          "roles": {
            "type": "array",
            "description": "รหัส Role ที่ได้รับใน Service นี้ ไม่ใช่สิทธิ์ CUSA Admin",
            "items": {
              "type": "string"
            }
          },
          "aud": {
            "type": "string",
            "description": "Application ID ต้องเท่ากับ SSO_APPLICATION_ID ของระบบคุณ",
            "format": "uuid"
          },
          "active": {
            "type": "boolean",
            "const": true
          },
          "exp": {
