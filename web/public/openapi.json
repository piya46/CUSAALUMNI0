          "token_type",
          "expires_in",
          "scope"
        ],
        "additionalProperties": false
      },
      "IntrospectionRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque access token",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "LoginContext": {
        "type": "object",
        "properties": {
          "application": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "ชื่อที่ลงทะเบียน"
              },
              "origin": {
                "type": "string",
                "description": "Origin จาก callback",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "origin"
            ],
            "additionalProperties": false
          },
          "returnTo": {
            "type": "string",
            "description": "Internal authorize path สำหรับ View ของ CUSA SSO"
          }
        },
        "required": [
          "application",
          "returnTo"
        ],
        "additionalProperties": false
      }
    }
  }
