          }
        ]
      },
      "options": {
        "operationId": "userInfoPreflight",
        "summary": "CORS preflight ของ userinfo",
        "description": "อนุญาต GET และ Authorization header จาก registered origin เท่านั้น",
        "tags": [
          "Identity"
        ],
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Origin ของ callback ที่ลงทะเบียน"
          },
          {
            "name": "Access-Control-Request-Method",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "GET"
          },
          {
            "name": "Access-Control-Request-Headers",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Authorization ถ้ามี"
          }
        ],
        "responses": {
          "204": {
            "description": "Preflight accepted; Access-Control-Allow-Origin เป็น origin ที่ตรวจแล้ว"
          },
          "400": {
            "description": "Validation / invalid grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid request parameters",
                  "code": "invalid_request"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid or expired API key",
                  "code": "invalid_client"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope / CORS / account access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "API key does not permit this operation",
                  "code": "insufficient_scope"
                }
              }
            }
          },
          "429": {
            "description": "Quota exceeded; respect Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Service request quota exceeded",
                  "code": "RATE_LIMITED"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "เวลารอเป็นวินาที ห้าม retry รัว",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable; fail closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Service unavailable",
                  "code": "AUDIT_UNAVAILABLE"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unable to process request",
                  "code": "INTERNAL_ERROR"
                }
              }
            }
          }
        }
      }
